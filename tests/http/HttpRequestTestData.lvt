		0x54, 0x54, 0x50, 0x2F, 0x78, 0x2E, 0x30, 0x0D, 0x0A, 0x0D, 0x0A, 0x47, 0x45, 0x28, 0x54, 0x20,
		0x2F, 0x20, 0x48, 0x54, 0x54, 0x50, 0x2F, 0x31, 0x2E, 0x30, 0x0D, 0x0A, 0x0D, 0x0A, 0x47, 0x45,
		0x54, 0x20, 0x2F, 0x20, 0x48, 0x54, 0x54, 0x50, 0x2F, 0x31, 0x2E, 0x30, 0x0D, 0x0A, 0x3A, 0x20,
		0x61, 0x0D, 0x0A, 0x0D, 0x0A, 0x47, 0x45, 0x54, 0x20, 0x2F, 0x20, 0x48, 0x54, 0x54, 0x50, 0x2F,
		0x31, 0x2E, 0x30, 0x0D, 0x0A, 0x58, 0x3A, 0x20, 0x61, 0x0A, 0x0D, 0x0A, 0x47, 0x45, 0x54, 0x20,
		0x2F, 0x20, 0x48, 0x54, 0x54, 0x50, 0x2F, 0x31, 0x2E, 0x30, 0x0D, 0x0A, 0x54, 0x72, 0x61, 0x6E,
		0x73, 0x66, 0x65, 0x72, 0x2D, 0x45, 0x6E, 0x63, 0x6F, 0x64, 0x69, 0x6E, 0x67, 0x3A, 0x0D, 0x0A,
		0x0D, 0x0A, 0x47, 0x45, 0x54, 0x20, 0x2F, 0x20, 0x48, 0x54, 0x54, 0x50, 0x2F, 0x31, 0x2E, 0x31,
		0x0D, 0x0A, 0x48, 0x6F, 0x73, 0x74, 0x3A, 0x20, 0x5B, 0x3A, 0x3A, 0x31, 0x5D, 0x0D, 0x0A, 0x0D,
		0x0A, 0x48, 0x45, 0x41, 0x44, 0x20, 0x2F, 0x20, 0x48, 0x54, 0x54, 0x50, 0x2F, 0x31, 0x2E, 0x30,
		0x0D, 0x0A, 0x0D, 0x0A]
	const OFFSETS[51] = [0, 18, 118, 137, 171, 177, 184, 197, 222, 248, 264, 283, 304, 324, 344, 375, 403, 431, 457, 475, 511, 538, 571, 627, 683, 723, 761, 796, 861, 926, 964, 1025, 1080, 1129, 1148, 1166, 1192, 1211, 1247, 1267, 1288, 1309, 1331, 1355, 1385, 1403, 1422, 1445, 1468, 1506, 1537]
	const LENGTHS[51] = [18, 100, 19, 34, 6, 7, 13, 25, 26, 16, 19, 21, 20, 20, 31, 28, 28, 26, 18, 36, 27, 33, 56, 56, 40, 38, 35, 65, 65, 38, 61, 55, 49, 19, 18, 26, 19, 36, 20, 21, 21, 22, 24, 30, 18, 19, 23, 23, 38, 31, 19]

	// Selected constant fixture extent and failure observations.
	offset: int
	length: int
	actualLength: int
	ready: bool
	failAt: int
	reads: int

	public fn Select(which: int)
	{
		ready = true
		failAt = -1
		reads = 0

		if (which < 0 || which >= 51) {
			ready = false
			return
		}

		offset = OFFSETS[which]
		length = LENGTHS[which]

		actualLength = length
	}

	public fn Limit(length: int)
	{
		this.length = length
	}

	public fn FailAt(index: int)
	{
		failAt = index
	}

	public fn Release()
	{
		ready = false
	}

	public fn GetReads() int
	{
		return reads
	}

	override fn IsReady() bool
	{
		return ready
	}

	override fn GetAvailableLength() int
	{
		return length
	}

	override fn TryRead(index: int, value: out byte) PacketDataResult
	{
		value = 0xFF
		reads = reads + 1

		if (!ready) {
			return PacketDataResult.NotReady
		}

		if (index < 0 || index >= length || index >= actualLength || index == failAt) {
			return PacketDataResult.Invalid
		}

		value = BYTES[offset + index]
		return PacketDataResult.Success
	}
}

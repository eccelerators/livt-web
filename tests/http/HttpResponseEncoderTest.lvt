	@Test
	fn BudgetAndReprepare()
	{
		this.Select(0)
		assert response.TryPrepare(HttpStatus.Ok, HttpContentType.Html, HttpAllowedMethods.None)
		assert encoder.TryPrepare(82)
		assert encoder.GetAvailableLength() == 82
		assert !encoder.TryPrepare(81)
		assert !encoder.IsReady()
		assert encoder.GetAvailableLength() == 0
		assert encoder.GetHeaderLength() == 0
		var value: byte = 0xFF
		assert encoder.TryRead(0, value) == PacketDataResult.NotReady
		assert value == 0x00
		assert !encoder.TryPrepare(0)
		assert !encoder.TryPrepare(-1)
		assert encoder.TryPrepare(82)
		assert data.GetReads() == 0
	}

	@Test
	fn NonemptyExactBudget()
	{
		this.Select(1000)
		assert response.TryPrepare(HttpStatus.Ok, HttpContentType.Html, HttpAllowedMethods.None)
		assert !encoder.TryPrepare(1084)
		assert encoder.TryPrepare(1085)
		assert encoder.GetAvailableLength() == 1085
	}

	@Test
	fn OverflowAndNegativeLength()
	{
		this.Select(2147483647)
		assert response.TryPrepare(HttpStatus.Ok, HttpContentType.Html, HttpAllowedMethods.None)
		assert !encoder.TryPrepare(2147483647)
		assert !encoder.IsReady()
		assert encoder.GetAvailableLength() == 0
		this.Select(-1)
		assert !response.TryPrepare(HttpStatus.Ok, HttpContentType.Html, HttpAllowedMethods.None)
		assert !direct.TryPrepare(2147483647)
		assert !direct.IsReady()
		assert data.GetReads() == 0
	}

	fn Reject(status: HttpStatus, contentType: HttpContentType, allowed: HttpAllowedMethods)
	{
		this.Select(1)
		assert response.TryPrepare(HttpStatus.Ok, HttpContentType.Html, HttpAllowedMethods.None)
		assert encoder.TryPrepare(1000)
		encoder.Invalidate()
		assert !response.TryPrepare(status, contentType, allowed)
		assert !response.IsReady()
		assert response.GetAvailableLength() == 0
		assert response.GetStatus() == HttpStatus.Unknown
		assert response.GetContentType() == HttpContentType.Unknown
		assert response.GetAllowedMethods() == HttpAllowedMethods.None
		assert !encoder.TryPrepare(1000)
		data.Metadata(status, contentType, allowed)
		assert !direct.TryPrepare(1000)
		assert !direct.IsReady()
		assert direct.GetAvailableLength() == 0
	}

	@Test
	fn UnsupportedMetadata()
	{
		this.Reject(HttpStatus.Unknown, HttpContentType.Html, HttpAllowedMethods.None)
		this.Reject(HttpStatus.Ok, HttpContentType.Unknown, HttpAllowedMethods.None)
		this.Reject(HttpStatus.MethodNotAllowed, HttpContentType.Html, HttpAllowedMethods.None)
		this.Reject(HttpStatus.Ok, HttpContentType.Html, HttpAllowedMethods.Get)
	}

	@Test
	fn UnpublishedAndReleasedSource()
	{
		this.Select(2)
		assert !encoder.IsReady()
		assert !encoder.TryPrepare(1000)
		assert response.TryPrepare(HttpStatus.Ok, HttpContentType.Html, HttpAllowedMethods.None)
		assert encoder.TryPrepare(1000)
		data.Release()
		assert !encoder.IsReady()
		assert !response.IsReady()
		assert encoder.GetAvailableLength() == 0
		assert !response.TryPrepare(HttpStatus.Ok, HttpContentType.Html, HttpAllowedMethods.None)
		assert !direct.TryPrepare(1000)
		data.Select(2)
		assert !response.IsReady()
		assert !encoder.IsReady()
	}

	fn Failure(failure: PacketDataResult)
	{
		this.Select(2)
		assert response.TryPrepare(HttpStatus.Ok, HttpContentType.Html, HttpAllowedMethods.None)
		assert encoder.TryPrepare(1000)
		data.FailAt(1, failure)
		var value: byte = 0xFF
		assert encoder.TryRead(82, value) == PacketDataResult.Success
		assert value == 0x00
		assert encoder.TryRead(83, value) == failure
		assert value == 0x00
		assert !encoder.IsReady()
		assert !response.IsReady()
		assert encoder.GetAvailableLength() == 0
		assert encoder.TryRead(0, value) == PacketDataResult.NotReady
		assert value == 0x00
		this.Select(2)
		assert response.TryPrepare(HttpStatus.Ok, HttpContentType.Html, HttpAllowedMethods.None)
		assert encoder.TryPrepare(1000)
		assert encoder.TryRead(83, value) == PacketDataResult.Success
		assert value == 0x01
	}

	@Test
	fn InvalidProviderRead()
	{
		this.Failure(PacketDataResult.Invalid)
	}

	@Test
	fn BusyProviderRead()
	{
		this.Failure(PacketDataResult.Busy)
	}

	@Test
	fn NotReadyProviderRead()
	{
		this.Failure(PacketDataResult.NotReady)
	}

	@Test
	fn DirectProviderFailure()
	{
		this.Select(1)
		assert direct.TryPrepare(1000)
		data.FailAt(0, PacketDataResult.Invalid)
		var value: byte = 0xFF
		assert direct.TryRead(82, value) == PacketDataResult.Invalid
		assert value == 0x00
		assert !direct.IsReady()
		assert data.IsReady()
	}

	@Test
	fn BorrowedBodyAndBounds()
	{
		this.Select(2)
		assert response.TryPrepare(HttpStatus.Ok, HttpContentType.Html, HttpAllowedMethods.None)
		var value: byte = 0xFF
		assert response.TryRead(-1, value) == PacketDataResult.Invalid
		assert value == 0x00
		assert response.TryRead(2, value) == PacketDataResult.Invalid
		assert value == 0x00
		assert response.IsReady()
		assert data.GetReads() == 0
		assert response.TryRead(1, value) == PacketDataResult.Success
		assert value == 0x01
		encoder.Invalidate()
		response.Invalidate()
		assert data.IsReady()
		assert response.TryRead(0, value) == PacketDataResult.NotReady
		assert value == 0x00
	}
}

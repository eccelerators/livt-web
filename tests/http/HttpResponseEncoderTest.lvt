	data: HttpResponseTestData
	response: HttpResponse<HttpResponseTestData>
	encoder: HttpResponseEncoder<HttpResponse<HttpResponseTestData>>
	direct: HttpResponseEncoder<HttpResponseTestData>

	new()
	{
		data = new HttpResponseTestData()
		response = new HttpResponse<HttpResponseTestData>(data)
		encoder = new HttpResponseEncoder<HttpResponse<HttpResponseTestData>>(response)
		direct = new HttpResponseEncoder<HttpResponseTestData>(data)
	}

	fn Select(length: int)
	{
		encoder.Invalidate()
		direct.Invalidate()
		response.Invalidate()
		data.Select(length)
	}

	fn Check(offset: int, headerLength: int, bodyLength: int, full: bool)
	{
		assert encoder.TryPrepare(2147483647)
		assert encoder.GetHeaderLength() == headerLength
		assert encoder.GetAvailableLength() == headerLength + bodyLength
		assert data.GetReads() == 0

		for (var i: int = 0; i < headerLength; i++) {
			var headerByte: byte = 0xFF
			assert encoder.TryRead(i, headerByte) == PacketDataResult.Success
			assert headerByte == EXPECTED[offset + i]
		}

		assert data.GetReads() == 0

		if (full) {
			for (var i: int = 0; i < bodyLength; i++) {
				var bodyByte: byte = 0xFF
				assert encoder.TryRead(headerLength + i, bodyByte) == PacketDataResult.Success
				assert bodyByte == ((i % 256) as byte)
			}
		}
		elif (bodyLength > 0) {
			var edgeByte: byte = 0xFF
			assert encoder.TryRead(headerLength, edgeByte) == PacketDataResult.Success
			assert edgeByte == 0x00
			assert encoder.TryRead(headerLength + bodyLength - 1, edgeByte) == PacketDataResult.Success
			assert edgeByte == (((bodyLength - 1) % 256) as byte)
		}

		var value: byte = 0xFF
		assert encoder.TryRead(-1, value) == PacketDataResult.Invalid
		assert value == 0x00
		assert encoder.TryRead(headerLength + bodyLength, value) == PacketDataResult.Invalid
		assert value == 0x00
		assert encoder.IsReady()
	}


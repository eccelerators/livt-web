namespace Livt.Web.Tests.Http

using Livt.Web.Http
using Livt.Net

@Test
component HttpRequestRecognizerTest
{
	// Shared request parsers; source remains owned by this fixture.
	dataReaderEthernet: EthernetFrameParser<ArrayPacketData<128>>
	dataReaderIpv4: Ipv4PacketParser<EthernetFrameParser<ArrayPacketData<128>>>

	data: ArrayPacketData<128>
	conn: TcpConnectionRecognizer<ArrayPacketData<128>>
	recognizer: HttpRequestRecognizer<TcpConnectionRecognizer<ArrayPacketData<128>>>

	new()
	{
		data = new ArrayPacketData<128>()
		this.dataReaderEthernet = new EthernetFrameParser<ArrayPacketData<128>>(data)
		this.dataReaderIpv4 = new Ipv4PacketParser<EthernetFrameParser<ArrayPacketData<128>>>(this.dataReaderEthernet)
		conn = new TcpConnectionRecognizer<ArrayPacketData<128>>(this.dataReaderEthernet, this.dataReaderIpv4)
		this.recognizer = new HttpRequestRecognizer<TcpConnectionRecognizer<ArrayPacketData<128>>>(conn)
	}

	@Test
	fn AcceptsMinimalIpv4TcpHttpGetRootRequest()
	{
		this.recognizer.SetPath(0x2F, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 1)
		var frame: byte[128]
		frame[17] = 0x72
		var httpGetRoot = "GET / ".Encode()
		var etherTypeIpv4: byte[2]
		etherTypeIpv4[0] = 0x08
		etherTypeIpv4[1] = 0x00
		var fixedIpv4TcpHeader: byte[4]
		fixedIpv4TcpHeader[0] = 0x45
		fixedIpv4TcpHeader[1] = 0x40
		fixedIpv4TcpHeader[2] = 0x00
		fixedIpv4TcpHeader[3] = 0x06
		var localIp: byte[4]
		localIp[0] = 0x0A
		localIp[1] = 0x00
		localIp[2] = 0x00
		localIp[3] = 0x01
		var localPort: byte[2]
		localPort[0] = 0x00
		localPort[1] = 0x50
		var tcpPshAck: byte[2]
		tcpPshAck[0] = 0x50
		tcpPshAck[1] = 0x18

		frame[12] = etherTypeIpv4[0]
		frame[13] = etherTypeIpv4[1]
		frame[14] = fixedIpv4TcpHeader[0]
		frame[20] = fixedIpv4TcpHeader[1]
		frame[21] = fixedIpv4TcpHeader[2]
		frame[23] = fixedIpv4TcpHeader[3]
		frame[30] = localIp[0]
		frame[31] = localIp[1]
		frame[32] = localIp[2]
		frame[33] = localIp[3]
		frame[36] = localPort[0]
		frame[37] = localPort[1]
		frame[46] = tcpPshAck[0]
		frame[47] = tcpPshAck[1]
		frame[54] = httpGetRoot[0]
		frame[55] = httpGetRoot[1]
		frame[56] = httpGetRoot[2]
		frame[57] = httpGetRoot[3]
		frame[58] = httpGetRoot[4]
		frame[59] = httpGetRoot[5]

		assert this.Matches(frame, localIp, localPort) == true
	}

	@Test
	fn RejectsWrongEndpointOrPayload()
	{
		this.recognizer.SetPath(0x2F, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 1)
		var frame: byte[128]
		frame[17] = 0x72
		var httpGetRoot = "GET / ".Encode()
		var etherTypeIpv4: byte[2]
		etherTypeIpv4[0] = 0x08
		etherTypeIpv4[1] = 0x00
		var fixedIpv4TcpHeader: byte[4]
		fixedIpv4TcpHeader[0] = 0x45
		fixedIpv4TcpHeader[1] = 0x40
		fixedIpv4TcpHeader[2] = 0x00
		fixedIpv4TcpHeader[3] = 0x06
		var localIp: byte[4]
		localIp[0] = 0x0A
		localIp[1] = 0x00
		localIp[2] = 0x00
		localIp[3] = 0x01
		var wrongIp: byte[4]
		wrongIp[0] = 0x0A
		wrongIp[1] = 0x00
		wrongIp[2] = 0x00
		wrongIp[3] = 0x02
		var localPort: byte[2]
		localPort[0] = 0x00
		localPort[1] = 0x50
		var wrongPort: byte[2]
		wrongPort[0] = 0x01
		wrongPort[1] = 0xBB
		var tcpPshAck: byte[2]
		tcpPshAck[0] = 0x50
		tcpPshAck[1] = 0x18

		frame[12] = etherTypeIpv4[0]
		frame[13] = etherTypeIpv4[1]
		frame[14] = fixedIpv4TcpHeader[0]
		frame[20] = fixedIpv4TcpHeader[1]
		frame[21] = fixedIpv4TcpHeader[2]
		frame[23] = fixedIpv4TcpHeader[3]
		frame[30] = localIp[0]
		frame[31] = localIp[1]
		frame[32] = localIp[2]
		frame[33] = localIp[3]
		frame[36] = localPort[0]
		frame[37] = localPort[1]
		frame[46] = tcpPshAck[0]
		frame[47] = tcpPshAck[1]
		frame[54] = httpGetRoot[0]
		frame[55] = httpGetRoot[1]
		frame[56] = httpGetRoot[2]
		frame[57] = httpGetRoot[3]
		frame[58] = httpGetRoot[4]
		frame[59] = httpGetRoot[5]

		assert this.Matches(frame, wrongIp, localPort) == false
		assert this.Matches(frame, localIp, wrongPort) == false

		frame[59] = 0x48
		assert this.Matches(frame, localIp, localPort) == false
	}

	@Test
	fn AcceptsConfiguredStatusPath()
	{
		this.recognizer.SetPath(0x2F, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 1)
		this.recognizer.SetPath(0x2F, 0x73, 0x74, 0x61, 0x74, 0x75, 0x73, 7)

		var frame: byte[128]
		frame[17] = 0x72
		var httpGetStatus = "GET /status ".Encode()
		var etherTypeIpv4: byte[2]
		etherTypeIpv4[0] = 0x08
		etherTypeIpv4[1] = 0x00
		var fixedIpv4TcpHeader: byte[4]
		fixedIpv4TcpHeader[0] = 0x45
		fixedIpv4TcpHeader[1] = 0x40
		fixedIpv4TcpHeader[2] = 0x00
		fixedIpv4TcpHeader[3] = 0x06
		var localIp: byte[4]
		localIp[0] = 0x0A
		localIp[1] = 0x00
		localIp[2] = 0x00
		localIp[3] = 0x01
		var localPort: byte[2]
		localPort[0] = 0x00
		localPort[1] = 0x50
		var tcpPshAck: byte[2]
		tcpPshAck[0] = 0x50
		tcpPshAck[1] = 0x18

		frame[12] = etherTypeIpv4[0]
		frame[13] = etherTypeIpv4[1]
		frame[14] = fixedIpv4TcpHeader[0]
		frame[20] = fixedIpv4TcpHeader[1]
		frame[21] = fixedIpv4TcpHeader[2]
		frame[23] = fixedIpv4TcpHeader[3]
		frame[30] = localIp[0]
		frame[31] = localIp[1]
		frame[32] = localIp[2]
		frame[33] = localIp[3]
		frame[36] = localPort[0]
		frame[37] = localPort[1]
		frame[46] = tcpPshAck[0]
		frame[47] = tcpPshAck[1]

		for (var i = 0; i < 12; i++)
		{
			frame[54 + i] = httpGetStatus[i]
		}

		assert this.Matches(frame, localIp, localPort) == true
	}

	@Test
	fn RejectsNonHttpOrFragmentedFrames()
	{
		this.recognizer.SetPath(0x2F, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 1)
		var frame: byte[128]
		frame[17] = 0x72
		var httpGetRoot = "GET / ".Encode()
		var etherTypeArp: byte[2]
		etherTypeArp[0] = 0x08
		etherTypeArp[1] = 0x06
		var fragmentedIpv4TcpHeader: byte[4]
		fragmentedIpv4TcpHeader[0] = 0x45
		fragmentedIpv4TcpHeader[1] = 0x20
		fragmentedIpv4TcpHeader[2] = 0x01
		fragmentedIpv4TcpHeader[3] = 0x06
		var localIp: byte[4]
		localIp[0] = 0x0A
		localIp[1] = 0x00
		localIp[2] = 0x00
		localIp[3] = 0x01
		var localPort: byte[2]
		localPort[0] = 0x00
		localPort[1] = 0x50
		var tcpPshAck: byte[2]
		tcpPshAck[0] = 0x50
		tcpPshAck[1] = 0x18

		frame[12] = etherTypeArp[0]
		frame[13] = etherTypeArp[1]
		frame[14] = fragmentedIpv4TcpHeader[0]
		frame[20] = fragmentedIpv4TcpHeader[1]
		frame[21] = fragmentedIpv4TcpHeader[2]
		frame[23] = fragmentedIpv4TcpHeader[3]
		frame[30] = localIp[0]
		frame[31] = localIp[1]
		frame[32] = localIp[2]
		frame[33] = localIp[3]
		frame[36] = localPort[0]
		frame[37] = localPort[1]
		frame[46] = tcpPshAck[0]
		frame[47] = tcpPshAck[1]
		frame[54] = httpGetRoot[0]
		frame[55] = httpGetRoot[1]
		frame[56] = httpGetRoot[2]
		frame[57] = httpGetRoot[3]
		frame[58] = httpGetRoot[4]
		frame[59] = httpGetRoot[5]

		assert this.Matches(frame, localIp, localPort) == false

		frame[13] = 0x00
		assert this.Matches(frame, localIp, localPort) == false
	}

	/**
	 * Combines explicit endpoint policy and bounded HTTP token recognition.
	 */
	fn Matches(frame: byte[128], ip: byte[4], port: byte[2], length: int = 128) bool
	{
		conn.Invalidate()

		if (data.IsReady()) { data.TryRelease() }
		else { data.TryClear() }

		for (var i = 0; i < length; i++) {
			assert data.TryWrite(i, frame[i]) == PacketDataResult.Success
		}

		data.TryPublish()
		conn.TryParse()
		return conn.IsPshAckPacket(ip, (port[0] as int) * 256 + (port[1] as int)) && recognizer.IsGetRequest()
	}

	/**
	 * Captured prefixes can match, but padding and stale storage cannot supply a token.
	 */
	@Test
	fn BoundsRecognitionByDeclaredAndCapturedLengths()
	{
		this.recognizer.SetPath(0x2F, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 1)
		var frame: byte[128]
		var ip: byte[4] = [0x0A, 0x00, 0x00, 0x01]
		var port: byte[2] = [0x00, 0x50]
		var token = "GET / ".Encode()
		frame[12] = 0x08
		frame[14] = 0x45
		frame[17] = 0x2E
		frame[23] = 0x06
		frame[30] = 0x0A
		frame[33] = 0x01
		frame[37] = 0x50
		frame[46] = 0x50
		frame[47] = 0x18

		for (var i = 0; i < 6; i++) {
			frame[54 + i] = token[i]
		}

		assert this.Matches(frame, ip, port, 60)
		frame[17] = 0x2D
		assert !this.Matches(frame, ip, port, 60)
		frame[17] = 0x2E
		assert !this.Matches(frame, ip, port, 59)
		frame[17] = 0xC8
		assert this.Matches(frame, ip, port, 60)
		assert conn.GetStatus() == PacketParseResult.HeaderOnly
		assert conn.GetDeclaredPayloadLength() == 160
		frame[14] = 0x65
		assert !this.Matches(frame, ip, port, 60)
		assert conn.GetAvailableLength() == 0
	}
}

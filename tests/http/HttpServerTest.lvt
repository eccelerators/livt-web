namespace Livt.Web.Tests.Http

using Livt.Web.Http
using Livt.Net

@Test
component HttpServerTest
{
	content: TestHttpContent
	data: RamPacketData<128>
	readerEthernet: EthernetFrameParser<RamPacketData<128>>
	readerIpv4: Ipv4PacketParser<EthernetFrameParser<RamPacketData<128>>>
	server: HttpServer<RamPacketData<128>, TestHttpContent>
	generator: HttpResponseGenerator
	fixture: byte[128]
	receiver: TestFrameReceiver<128>

	new()
	{
		var localMac: byte[6]
		localMac[0] = 0x02
		localMac[1] = 0xAA
		localMac[2] = 0xBB
		localMac[3] = 0xCC
		localMac[4] = 0xDD
		localMac[5] = 0xEE
		this.receiver = new TestFrameReceiver<128>()
		this.generator = new HttpResponseGenerator()
		var localIp: byte[4]
		localIp[0] = 0x0A
		localIp[1] = 0x00
		localIp[2] = 0x00
		localIp[3] = 0x01
		var localPort: byte[2]
		localPort[0] = 0x00
		localPort[1] = 0x50
		this.content = new TestHttpContent()
		this.data = new RamPacketData<128>()
		this.readerEthernet = new EthernetFrameParser<RamPacketData<128>>(this.data)
		this.readerIpv4 = new Ipv4PacketParser<EthernetFrameParser<RamPacketData<128>>>(this.readerEthernet)
		this.server = new HttpServer<RamPacketData<128>, TestHttpContent>(this.readerEthernet, this.readerIpv4, this.content, localMac, localIp, localPort)
	}

	fn LoadFixtureByte(index: int, value: byte)
	{
		this.fixture[index] = value
	}

	fn SubmitFixture()
	{
		for (var i = 0; i < 128; i++) {
			assert this.receiver.InjectByte(i, this.fixture[i]) == FrameLinkResult.Success
		}

		assert this.receiver.Publish(true, 128) == FrameLinkResult.Success
		assert this.receiver.TryAcquire() == FrameLinkResult.Success
	}

	fn CopyFrameToServer()
	{
		this.server.BeginFrame()
		if (this.data.IsReady()) {
			this.data.TryRelease()
		} else {
			this.data.TryClear()
		}

		for (var i = 0; i < 128; i++) {
			var value: byte = 0x00
			assert this.receiver.TryRead(i, value) == PacketDataResult.Success
			this.data.TryWrite(i, value)
		}

		assert this.receiver.TryRelease() == FrameLinkResult.Success
		this.data.TryPublish()
		this.server.HandleFrame()
	}

	fn LoadArpEthernetIpv4RequestHeader(header: byte[8])
	{
		this.LoadFixtureByte(12, 0x08)
		this.LoadFixtureByte(13, 0x06)
		this.LoadFixtureByte(14, header[0])
		this.LoadFixtureByte(15, header[1])
		this.LoadFixtureByte(16, header[2])
		this.LoadFixtureByte(17, header[3])
		this.LoadFixtureByte(18, header[4])
		this.LoadFixtureByte(19, header[5])
		this.LoadFixtureByte(20, header[6])
		this.LoadFixtureByte(21, header[7])
	}

	fn LoadArpSenderMac(senderMac: byte[6])
	{
		this.LoadFixtureByte(22, senderMac[0])
		this.LoadFixtureByte(23, senderMac[1])
		this.LoadFixtureByte(24, senderMac[2])
		this.LoadFixtureByte(25, senderMac[3])
		this.LoadFixtureByte(26, senderMac[4])
		this.LoadFixtureByte(27, senderMac[5])
	}

	fn LoadArpTargetIp(targetIp: byte[4])
	{
		this.LoadFixtureByte(38, targetIp[0])
		this.LoadFixtureByte(39, targetIp[1])
		this.LoadFixtureByte(40, targetIp[2])
		this.LoadFixtureByte(41, targetIp[3])
	}

	fn LoadEtherType(etherType: byte[2])
	{
		this.LoadFixtureByte(12, etherType[0])
		this.LoadFixtureByte(13, etherType[1])
	}

	fn LoadEthernetSourceMac(sourceMac: byte[6])
	{
		this.LoadFixtureByte(6, sourceMac[0])
		this.LoadFixtureByte(7, sourceMac[1])
		this.LoadFixtureByte(8, sourceMac[2])
		this.LoadFixtureByte(9, sourceMac[3])
		this.LoadFixtureByte(10, sourceMac[4])
		this.LoadFixtureByte(11, sourceMac[5])
	}

	fn LoadIpv4FixedTcpHeader(ipHeader: byte[4])
	{
		this.LoadFixtureByte(16, 0x00)
		this.LoadFixtureByte(17, 0x28)
		this.LoadFixtureByte(14, ipHeader[0])
		this.LoadFixtureByte(20, ipHeader[1])
		this.LoadFixtureByte(21, ipHeader[2])
		this.LoadFixtureByte(23, ipHeader[3])
	}

	fn LoadIpv4SourceIp(sourceIp: byte[4])
	{
		this.LoadFixtureByte(26, sourceIp[0])
		this.LoadFixtureByte(27, sourceIp[1])
		this.LoadFixtureByte(28, sourceIp[2])
		this.LoadFixtureByte(29, sourceIp[3])
	}

	fn LoadIpv4DestinationIp(destinationIp: byte[4])
	{
		this.LoadFixtureByte(30, destinationIp[0])
		this.LoadFixtureByte(31, destinationIp[1])
		this.LoadFixtureByte(32, destinationIp[2])
		this.LoadFixtureByte(33, destinationIp[3])
	}

	fn LoadTcpSourcePort(sourcePort: byte[2])
	{
		this.LoadFixtureByte(34, sourcePort[0])
		this.LoadFixtureByte(35, sourcePort[1])
	}

	fn LoadTcpDestinationPort(destinationPort: byte[2])
	{
		this.LoadFixtureByte(36, destinationPort[0])
		this.LoadFixtureByte(37, destinationPort[1])
	}

	fn LoadTcpSeqNum(seqNum: byte[4])
	{
		this.LoadFixtureByte(38, seqNum[0])
		this.LoadFixtureByte(39, seqNum[1])
		this.LoadFixtureByte(40, seqNum[2])
		this.LoadFixtureByte(41, seqNum[3])
	}

	fn LoadTcpDataOffsetAndFlags(dataOffsetAndFlags: byte[2])
	{
		this.LoadFixtureByte(46, dataOffsetAndFlags[0])
		this.LoadFixtureByte(47, dataOffsetAndFlags[1])
	}

	fn LoadTcpPayload6(payload: byte[6])
	{
		this.LoadFixtureByte(17, 0x2E)
		this.LoadFixtureByte(54, payload[0])
		this.LoadFixtureByte(55, payload[1])
		this.LoadFixtureByte(56, payload[2])
		this.LoadFixtureByte(57, payload[3])
		this.LoadFixtureByte(58, payload[4])
		this.LoadFixtureByte(59, payload[5])
	}

	@Test
	fn IgnoresArpRequest()
	{
		for (var i = 0; i < 128; i++) {
			this.fixture[i] = 0x00
		}

		var arpEthernetIpv4Request: byte[8]
		arpEthernetIpv4Request[0] = 0x00
		arpEthernetIpv4Request[1] = 0x01
		arpEthernetIpv4Request[2] = 0x08
		arpEthernetIpv4Request[3] = 0x00
		arpEthernetIpv4Request[4] = 0x06
		arpEthernetIpv4Request[5] = 0x04
		arpEthernetIpv4Request[6] = 0x00
		arpEthernetIpv4Request[7] = 0x01

		var clientMac: byte[6]
		clientMac[0] = 0x02
		clientMac[1] = 0x10
		clientMac[2] = 0x20
		clientMac[3] = 0x30
		clientMac[4] = 0x40
		clientMac[5] = 0x50

		var localIp: byte[4]
		localIp[0] = 0x0A
		localIp[1] = 0x00
		localIp[2] = 0x00
		localIp[3] = 0x01

		this.LoadArpEthernetIpv4RequestHeader(arpEthernetIpv4Request)
		this.LoadArpSenderMac(clientMac)
		this.LoadArpTargetIp(localIp)
		this.SubmitFixture()

		this.CopyFrameToServer()

		assert this.server.HasResponse() == false
		assert this.server.GetResponseKind() == 0
		assert this.server.GetResponseLength() == 0
	}

	@Test
	fn RespondsToHttpGetRootRequest()
	{
		for (var i = 0; i < 128; i++) {
			this.fixture[i] = 0x00
		}

		this.content.Configure(1, 64)

		var httpGetRoot = "GET / ".Encode()

		var clientMac: byte[6]
		clientMac[0] = 0x02
		clientMac[1] = 0x10
		clientMac[2] = 0x20
		clientMac[3] = 0x30
		clientMac[4] = 0x40
		clientMac[5] = 0x50

		var clientIp: byte[4]
		clientIp[0] = 0x0A
		clientIp[1] = 0x00
		clientIp[2] = 0x00
		clientIp[3] = 0x02

		var etherTypeIpv4: byte[2]
		etherTypeIpv4[0] = 0x08
		etherTypeIpv4[1] = 0x00

		var fixedIpv4TcpHeader: byte[4]
		fixedIpv4TcpHeader[0] = 0x45
		fixedIpv4TcpHeader[1] = 0x40
		fixedIpv4TcpHeader[2] = 0x00
		fixedIpv4TcpHeader[3] = 0x06

		var localIp: byte[4]
		localIp[0] = 0x0A
		localIp[1] = 0x00
		localIp[2] = 0x00
		localIp[3] = 0x01

		var clientPort: byte[2]
		clientPort[0] = 0xC0
		clientPort[1] = 0x01

		var httpPort: byte[2]
		httpPort[0] = 0x00
		httpPort[1] = 0x50

		var clientSeq: byte[4]
		clientSeq[0] = 0xAA
		clientSeq[1] = 0xBB
		clientSeq[2] = 0xCC
		clientSeq[3] = 0xDD

		// Send SYN
		var tcpSyn: byte[2]
		tcpSyn[0] = 0x50
		tcpSyn[1] = 0x02

		this.LoadEthernetSourceMac(clientMac)
		this.LoadEtherType(etherTypeIpv4)
		this.LoadIpv4FixedTcpHeader(fixedIpv4TcpHeader)
		this.LoadIpv4SourceIp(clientIp)
		this.LoadIpv4DestinationIp(localIp)
		this.LoadTcpSourcePort(clientPort)
		this.LoadTcpDestinationPort(httpPort)
		this.LoadTcpSeqNum(clientSeq)
		this.LoadTcpDataOffsetAndFlags(tcpSyn)
		this.SubmitFixture()

		this.CopyFrameToServer()

		assert this.server.GetResponseKind() == 3
		assert this.server.GetResponseLength() == 60

		// A host retransmits SYN when the SYN-ACK is missed or rejected. The
		// endpoint should refresh and send SYN-ACK again while in SYN_RECEIVED.
		this.SubmitFixture()

		this.CopyFrameToServer()

		assert this.server.GetResponseKind() == 3
		assert this.server.GetResponseLength() == 60

		// Send ACK
		var tcpAck: byte[2]
		tcpAck[0] = 0x50
		tcpAck[1] = 0x10

		this.LoadTcpDataOffsetAndFlags(tcpAck)
		this.SubmitFixture()

		this.CopyFrameToServer()

		assert this.server.HasResponse() == false

		// Send HTTP GET
		var tcpPshAck: byte[2]
		tcpPshAck[0] = 0x50
		tcpPshAck[1] = 0x18

		this.LoadTcpDataOffsetAndFlags(tcpPshAck)
		this.LoadTcpPayload6(httpGetRoot)
		this.SubmitFixture()

		this.CopyFrameToServer()

		var indexLength = 64
		var bodyOffset = this.generator.GetBodyFrameOffset(indexLength)
		var expectedResponseLength = this.generator.GetResponseFrameLength(indexLength)

		assert this.server.AcceptedHttpRequest() == true
		assert this.server.GetResponseKind() == 2
		assert this.server.GetResponseLength() == expectedResponseLength
		assert this.server.IsHttpBodyFrameIndex(bodyOffset) == true
		assert this.server.GetHttpBodyIndex(bodyOffset) == 0
		assert this.ReadResponse(bodyOffset) == 0x3C
	}

	@Test
	fn CalculatesSynAckChecksumForHighTcpBytes()
	{
		for (var i = 0; i < 128; i++) {
			this.fixture[i] = 0x00
		}

		var clientMac: byte[6]
		clientMac[0] = 0x9C
		clientMac[1] = 0xEB
		clientMac[2] = 0xE8
		clientMac[3] = 0x16
		clientMac[4] = 0x7A
		clientMac[5] = 0x21

		var clientIp: byte[4]
		clientIp[0] = 0x0A
		clientIp[1] = 0x00
		clientIp[2] = 0x00
		clientIp[3] = 0x65

		var localIp: byte[4]
		localIp[0] = 0x0A
		localIp[1] = 0x00
		localIp[2] = 0x00
		localIp[3] = 0x01

		var etherTypeIpv4: byte[2]
		etherTypeIpv4[0] = 0x08
		etherTypeIpv4[1] = 0x00

		var fixedIpv4TcpHeader: byte[4]
		fixedIpv4TcpHeader[0] = 0x45
		fixedIpv4TcpHeader[1] = 0x40
		fixedIpv4TcpHeader[2] = 0x00
		fixedIpv4TcpHeader[3] = 0x06

		var clientPort: byte[2]
		clientPort[0] = 0x8C
		clientPort[1] = 0x8A

		var httpPort: byte[2]
		httpPort[0] = 0x00
		httpPort[1] = 0x50

		var clientSeq: byte[4]
		clientSeq[0] = 0x8F
		clientSeq[1] = 0x4E
		clientSeq[2] = 0x3C
		clientSeq[3] = 0x39

		var tcpSyn: byte[2]
		tcpSyn[0] = 0x50
		tcpSyn[1] = 0x02

		this.LoadEthernetSourceMac(clientMac)
		this.LoadEtherType(etherTypeIpv4)
		this.LoadIpv4FixedTcpHeader(fixedIpv4TcpHeader)
		this.LoadIpv4SourceIp(clientIp)
		this.LoadIpv4DestinationIp(localIp)
		this.LoadTcpSourcePort(clientPort)
		this.LoadTcpDestinationPort(httpPort)
		this.LoadTcpSeqNum(clientSeq)
		this.LoadTcpDataOffsetAndFlags(tcpSyn)
		this.SubmitFixture()

		this.CopyFrameToServer()

		assert this.server.GetResponseKind() == 3
		assert this.ReadResponse(24) == 0x26
		assert this.ReadResponse(25) == 0x69
		assert this.ReadResponse(42) == 0x8F
		assert this.ReadResponse(45) == 0x3A
		assert this.ReadResponse(50) == 0x3F
		assert this.ReadResponse(51) == 0x09
	}

	@Test
	fn RespondsToHttpGetAboutRequest()
	{
		for (var i = 0; i < 128; i++) {
			this.fixture[i] = 0x00
		}

		// Route 2 (/about, 70-byte body) must produce a 188-byte frame
		// (Ethernet 14 + IPv4 20 + TCP 20 + HTTP header 64 + body 70),
		// not the 182-byte frame used for the / route (64-byte body).
		this.content.Configure(1, 64)
		this.content.Configure(2, 70)
		this.server.SetRoutePath(2, 2)

		var clientMac: byte[6]
		clientMac[0] = 0x02
		clientMac[1] = 0x10
		clientMac[2] = 0x20
		clientMac[3] = 0x30
		clientMac[4] = 0x40
		clientMac[5] = 0x50

		var clientIp: byte[4]
		clientIp[0] = 0x0A
		clientIp[1] = 0x00
		clientIp[2] = 0x00
		clientIp[3] = 0x02

		var etherTypeIpv4: byte[2]
		etherTypeIpv4[0] = 0x08
		etherTypeIpv4[1] = 0x00

		var fixedIpv4TcpHeader: byte[4]
		fixedIpv4TcpHeader[0] = 0x45
		fixedIpv4TcpHeader[1] = 0x40
		fixedIpv4TcpHeader[2] = 0x00
		fixedIpv4TcpHeader[3] = 0x06

		var localIp: byte[4]
		localIp[0] = 0x0A
		localIp[1] = 0x00
		localIp[2] = 0x00
		localIp[3] = 0x01

		var clientPort: byte[2]
		clientPort[0] = 0xC0
		clientPort[1] = 0x01

		var httpPort: byte[2]
		httpPort[0] = 0x00
		httpPort[1] = 0x50

		var clientSeq: byte[4]
		clientSeq[0] = 0xAA
		clientSeq[1] = 0xBB
		clientSeq[2] = 0xCC
		clientSeq[3] = 0xDD

		// Send SYN
		var tcpSyn: byte[2]
		tcpSyn[0] = 0x50
		tcpSyn[1] = 0x02

		this.LoadEthernetSourceMac(clientMac)
		this.LoadEtherType(etherTypeIpv4)
		this.LoadIpv4FixedTcpHeader(fixedIpv4TcpHeader)
		this.LoadIpv4SourceIp(clientIp)
		this.LoadIpv4DestinationIp(localIp)
		this.LoadTcpSourcePort(clientPort)
		this.LoadTcpDestinationPort(httpPort)
		this.LoadTcpSeqNum(clientSeq)
		this.LoadTcpDataOffsetAndFlags(tcpSyn)
		this.SubmitFixture()

		this.CopyFrameToServer()

		assert this.server.GetResponseKind() == 3

		// Send ACK to complete handshake
		var tcpAck: byte[2]
		tcpAck[0] = 0x50
		tcpAck[1] = 0x10

		this.LoadTcpDataOffsetAndFlags(tcpAck)
		this.SubmitFixture()

		this.CopyFrameToServer()

		assert this.server.HasResponse() == false

		// Send PSH+ACK with GET /about
		var tcpPshAck: byte[2]
		tcpPshAck[0] = 0x50
		tcpPshAck[1] = 0x18

		this.LoadTcpDataOffsetAndFlags(tcpPshAck)
		this.LoadFixtureByte(17, 0x33)
		// "GET /about " = 47 45 54 20 2F 61 62 6F 75 74 20
		this.LoadFixtureByte(54, 0x47)
		this.LoadFixtureByte(55, 0x45)
		this.LoadFixtureByte(56, 0x54)
		this.LoadFixtureByte(57, 0x20)
		this.LoadFixtureByte(58, 0x2F)
		this.LoadFixtureByte(59, 0x61)
		this.LoadFixtureByte(60, 0x62)
		this.LoadFixtureByte(61, 0x6F)
		this.LoadFixtureByte(62, 0x75)
		this.LoadFixtureByte(63, 0x74)
		this.LoadFixtureByte(64, 0x20)
		this.SubmitFixture()

		this.CopyFrameToServer()

		var aboutLength = 70
		var expectedResponseLength = this.generator.GetResponseFrameLength(aboutLength)

		assert this.server.AcceptedRoute2Request() == true
		assert this.server.GetResponseKind() == 4
		assert this.server.GetResponseLength() == expectedResponseLength
	}

	@Test
	fn RespondsToHttpGetStatusRequest()
	{
		for (var i = 0; i < 128; i++) {
			this.fixture[i] = 0x00
		}

		this.content.Configure(1, 64)
		this.content.Configure(2, 70)
		this.content.Configure(3, 451)
		this.server.SetRoutePath(2, 2)
		this.server.SetRoutePath(3, 3)

		var clientMac: byte[6]
		clientMac[0] = 0x02
		clientMac[1] = 0x10
		clientMac[2] = 0x20
		clientMac[3] = 0x30
		clientMac[4] = 0x40
		clientMac[5] = 0x50

		var clientIp: byte[4]
		clientIp[0] = 0x0A
		clientIp[1] = 0x00
		clientIp[2] = 0x00
		clientIp[3] = 0x02

		var etherTypeIpv4: byte[2]
		etherTypeIpv4[0] = 0x08
		etherTypeIpv4[1] = 0x00

		var fixedIpv4TcpHeader: byte[4]
		fixedIpv4TcpHeader[0] = 0x45
		fixedIpv4TcpHeader[1] = 0x40
		fixedIpv4TcpHeader[2] = 0x00
		fixedIpv4TcpHeader[3] = 0x06

		var localIp: byte[4]
		localIp[0] = 0x0A
		localIp[1] = 0x00
		localIp[2] = 0x00
		localIp[3] = 0x01

		var clientPort: byte[2]
		clientPort[0] = 0xC0
		clientPort[1] = 0x01

		var httpPort: byte[2]
		httpPort[0] = 0x00
		httpPort[1] = 0x50

		var clientSeq: byte[4]
		clientSeq[0] = 0xAA
		clientSeq[1] = 0xBB
		clientSeq[2] = 0xCC
		clientSeq[3] = 0xDD

		var tcpSyn: byte[2]
		tcpSyn[0] = 0x50
		tcpSyn[1] = 0x02

		this.LoadEthernetSourceMac(clientMac)
		this.LoadEtherType(etherTypeIpv4)
		this.LoadIpv4FixedTcpHeader(fixedIpv4TcpHeader)
		this.LoadIpv4SourceIp(clientIp)
		this.LoadIpv4DestinationIp(localIp)
		this.LoadTcpSourcePort(clientPort)
		this.LoadTcpDestinationPort(httpPort)

namespace Livt.Web.Tests.Http

using Livt.Net
using Livt.Web.Http

@Test
component HttpRequestParserTest
{
	data: HttpRequestTestData
	parser: HttpRequestParser<HttpRequestTestData, 256, 64, 8>

	new()
	{
		data = new HttpRequestTestData()
		parser = new HttpRequestParser<HttpRequestTestData, 256, 64, 8>(data)
	}

	fn Select(which: int)
	{
		parser.Invalidate()
		data.Select(which)
	}

	@Test
	fn Minimal()
	{
		this.Select(0)
		assert parser.TryParse() == HttpRequestResult.Ready
		assert parser.IsReady() == true
	}

	@Test
	fn Version11Host()
	{
		this.Select(3)
		assert parser.TryParse() == HttpRequestResult.Ready
		assert parser.IsReady() == true
	}

	@Test
	fn PartialToken()
	{
		this.Select(4)
		assert parser.TryParse() == HttpRequestResult.Incomplete
		assert parser.IsReady() == false
		assert parser.GetPathLength() == 0
		assert parser.GetHeaderCount() == 0
		var value: byte = 0x00
		assert parser.TryReadPath(0, value) == PacketDataResult.NotReady
	}


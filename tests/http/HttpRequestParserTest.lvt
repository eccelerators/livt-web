	@Test
	fn TypedViewsAndBounds()
	{
		this.Select(1)
		assert parser.TryParse() == HttpRequestResult.Ready
		assert parser.GetMethod() == HttpMethod.Get
		assert parser.GetVersion() == HttpVersion.Http11
		assert parser.GetPathLength() == 6
		assert parser.HasQuery()
		assert parser.GetQueryLength() == 5
		assert parser.GetHeaderCount() == 4
		assert parser.GetHeaderKind(0) == HttpHeaderName.Host
		assert parser.GetHeaderKind(1) == HttpHeaderName.Other
		assert parser.GetHeaderKind(3) == HttpHeaderName.ContentLength
		var path = "/a%2Fb".Encode()
		var query = "x=1??".Encode()
		var value: byte = 0x00

		for (var i = 0; i < 6; i++) {
			assert parser.TryReadPath(i, value) == PacketDataResult.Success
			assert value == path[i]
		}

		for (var i = 0; i < 5; i++) {
			assert parser.TryReadQuery(i, value) == PacketDataResult.Success
			assert value == query[i]
		}

		assert parser.GetHeaderNameLength(0) == 4
		assert parser.TryReadHeaderName(0, 1, value) == PacketDataResult.Success
		assert value == 0x4F
		assert parser.GetHeaderValueLength(0) == 14
		assert parser.GetHeaderValueLength(1) == 3
		assert parser.TryReadHeaderValue(1, 1, value) == PacketDataResult.Success
		assert value == 0x09
		assert parser.GetHeaderValueLength(2) == 0
		assert parser.TryReadPath(-1, value) == PacketDataResult.Invalid
		assert parser.TryReadPath(6, value) == PacketDataResult.Invalid
		assert parser.TryReadQuery(5, value) == PacketDataResult.Invalid
		assert parser.TryReadHeaderName(0, 4, value) == PacketDataResult.Invalid
		assert parser.TryReadHeaderValue(2, 0, value) == PacketDataResult.Invalid
		assert parser.TryReadHeaderValue(4, 0, value) == PacketDataResult.Invalid
		assert parser.GetHeaderNameLength(-1) == 0
		assert parser.IsReady()
	}

	@Test
	fn MissingAndEmptyQueriesAreDistinct()
	{
		this.Select(0)
		assert parser.TryParse() == HttpRequestResult.Ready
		assert !parser.HasQuery()
		assert parser.GetQueryLength() == 0
		this.Select(2)
		assert parser.TryParse() == HttpRequestResult.Ready
		assert parser.HasQuery()
		assert parser.GetQueryLength() == 0
		var value: byte = 0x00
		assert parser.TryReadQuery(0, value) == PacketDataResult.Invalid
	}

	@Test
	fn EveryTruncatedPrefixStaysUnpublished()
	{
		for (var i = 0; i < 18; i++) {
			this.Select(0)
			data.Limit(i)
			assert parser.TryParse() == HttpRequestResult.Incomplete
			assert !parser.IsReady()
		}
	}

	@Test
	fn ProviderFailureAndRecovery()
	{
		this.Select(0)
		data.FailAt(5)
		assert parser.TryParse() == HttpRequestResult.ReadFailure
		assert !parser.IsReady()
		this.Select(0)
		assert parser.TryParse() == HttpRequestResult.Ready
		data.FailAt(4)
		var value: byte = 0x00
		assert parser.TryReadPath(0, value) == PacketDataResult.Invalid
		assert value == 0x00
		assert parser.GetResult() == HttpRequestResult.ReadFailure
		assert !parser.IsReady()
		this.Select(2)
		assert parser.TryParse() == HttpRequestResult.Ready
		assert parser.HasQuery()
		parser.Invalidate()
		assert parser.GetMethod() == HttpMethod.Other
		assert parser.GetVersion() == HttpVersion.Unknown
		assert !parser.HasQuery()
		assert parser.GetPathLength() == 0
		assert parser.TryReadPath(0, value) == PacketDataResult.NotReady
		data.Release()
		assert parser.TryParse() == HttpRequestResult.NotReady
	}

	@Test
	fn HeaderReadFailureStaysUnpublished()
	{
		this.Select(1)
		data.FailAt(29)
		assert parser.TryParse() == HttpRequestResult.ReadFailure
		assert !parser.IsReady()
	}

	@Test
	fn PreservesEncodedAndTrailingSlashPaths()
	{
		this.Select(38)
		assert parser.TryParse() == HttpRequestResult.Ready
		assert parser.GetPathLength() == 3
		var value: byte = 0x00
		assert parser.TryReadPath(2, value) == PacketDataResult.Success
		assert value == 0x2F
		this.Select(39)
		assert parser.TryParse() == HttpRequestResult.Ready
		assert parser.GetPathLength() == 4
		assert parser.TryReadPath(1, value) == PacketDataResult.Success
		assert value == 0x25
		assert parser.TryReadPath(3, value) == PacketDataResult.Success
		assert value == 0x31
	}

	@Test
	fn HeadIsClassifiedWithoutImplementingItsResponse()
	{
		this.Select(50)
		assert parser.TryParse() == HttpRequestResult.Ready
		assert parser.GetMethod() == HttpMethod.Head
		assert parser.GetPathLength() == 1
	}
}

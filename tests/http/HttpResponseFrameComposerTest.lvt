namespace Livt.Web.Tests.Http
using Livt.Net
using Livt.Web.Http

/** Full expected HTTP frames generated independently of Livt encoders/checksums. */
@Test
component HttpResponseFrameComposerTest
{
	body: ArrayPacketData<1400>
	composer: HttpResponseFrameComposer<ArrayPacketData<1400>>
	new()
	{
		this.body = new ArrayPacketData<1400>()
		this.composer = new HttpResponseFrameComposer<ArrayPacketData<1400>>(this.body)
	}

	fn Prepare(size: int) PacketDataResult
	{
		this.composer.Invalidate()

		if (this.body.IsReady()) {
			this.body.TryRelease()
		}
		else {
			this.body.TryClear()
		}

		for (var i = 0; i < size; i++) {
			assert this.body.TryWrite(i, (128 + i) as byte) == PacketDataResult.Success
		}

		assert this.body.TryPublish() == PacketDataResult.Success
		var sourceMac: byte[6] = [0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE]
		var destinationMac: byte[6] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE]
		var sourceIp: byte[4] = [0xC0, 0xA8, 0x01, 0x80]
		var destinationIp: byte[4] = [0xC0, 0xA8, 0x01, 0xFF]
		var sourcePort: byte[2] = [0x00, 0x50]
		var destinationPort: byte[2] = [0xC0, 0x81]
		var sequence: byte[4] = [0x80, 0x12, 0x34, 0xFF]
		var ack: byte[4] = [0xFE, 0xDC, 0xBA, 0x98]
		var window: byte[2] = [0x81, 0x23]
		return this.composer.TryPrepare(sourceMac, destinationMac, sourceIp, destinationIp, sourcePort, destinationPort, sequence, ack, 0x12, window)
	}

	@Test
	fn EmitsCompleteBody0()
	{
		assert this.Prepare(0) == PacketDataResult.Success
		assert this.composer.GetAvailableLength() == 117
		var expected: byte[117] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0x08, 0x00, 0x45, 0x00, 0x00, 0x67, 0x00, 0x01, 0x40, 0x00, 0x40, 0x06, 0xB5, 0xC0, 0xC0, 0xA8, 0x01, 0x80, 0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x50, 0xC0, 0x81, 0x80, 0x12, 0x34, 0xFF, 0xFE, 0xDC, 0xBA, 0x98, 0x50, 0x12, 0x81, 0x23, 0x46, 0x02, 0x00, 0x00, 0x48, 0x54, 0x54, 0x50, 0x2F, 0x31, 0x2E, 0x30, 0x20, 0x32, 0x30, 0x30, 0x20, 0x4F, 0x4B, 0x0D, 0x0A, 0x43, 0x6F, 0x6E, 0x74, 0x65, 0x6E, 0x74, 0x2D, 0x54, 0x79, 0x70, 0x65, 0x3A, 0x20, 0x74, 0x65, 0x78, 0x74, 0x2F, 0x68, 0x74, 0x6D, 0x6C, 0x0D, 0x0A, 0x43, 0x6F, 0x6E, 0x74, 0x65, 0x6E, 0x74, 0x2D, 0x4C, 0x65, 0x6E, 0x67, 0x74, 0x68, 0x3A, 0x20, 0x30, 0x0D, 0x0A, 0x0D, 0x0A]
		var value: byte = 0x00

		for (var i = 0; i < 117; i++) {
			assert this.composer.TryRead(i, value) == PacketDataResult.Success
			assert value == expected[i]
		}

		assert this.composer.TryRead(-1, value) == PacketDataResult.Invalid
		assert this.composer.TryRead(117, value) == PacketDataResult.Invalid
	}

	@Test
	fn EmitsCompleteBody3()
	{
		assert this.Prepare(3) == PacketDataResult.Success
		assert this.composer.GetAvailableLength() == 120
		var expected: byte[120] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0x08, 0x00, 0x45, 0x00, 0x00, 0x6A, 0x00, 0x01, 0x40, 0x00, 0x40, 0x06, 0xB5, 0xBD, 0xC0, 0xA8, 0x01, 0x80, 0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x50, 0xC0, 0x81, 0x80, 0x12, 0x34, 0xFF, 0xFE, 0xDC, 0xBA, 0x98, 0x50, 0x12, 0x81, 0x23, 0xC0, 0xFC, 0x00, 0x00, 0x48, 0x54, 0x54, 0x50, 0x2F, 0x31, 0x2E, 0x30, 0x20, 0x32, 0x30, 0x30, 0x20, 0x4F, 0x4B, 0x0D, 0x0A, 0x43, 0x6F, 0x6E, 0x74, 0x65, 0x6E, 0x74, 0x2D, 0x54, 0x79, 0x70, 0x65, 0x3A, 0x20, 0x74, 0x65, 0x78, 0x74, 0x2F, 0x68, 0x74, 0x6D, 0x6C, 0x0D, 0x0A, 0x43, 0x6F, 0x6E, 0x74, 0x65, 0x6E, 0x74, 0x2D, 0x4C, 0x65, 0x6E, 0x67, 0x74, 0x68, 0x3A, 0x20, 0x33, 0x0D, 0x0A, 0x0D, 0x0A, 0x80, 0x81, 0x82]
		var value: byte = 0x00

		for (var i = 0; i < 120; i++) {
			assert this.composer.TryRead(i, value) == PacketDataResult.Success
			assert value == expected[i]
		}

		assert this.composer.TryRead(-1, value) == PacketDataResult.Invalid
		assert this.composer.TryRead(120, value) == PacketDataResult.Invalid
	}

	@Test
	fn EmitsCompleteBody10()
	{
		assert this.Prepare(10) == PacketDataResult.Success
		assert this.composer.GetAvailableLength() == 128
		var expected: byte[128] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0x08, 0x00, 0x45, 0x00, 0x00, 0x72, 0x00, 0x01, 0x40, 0x00, 0x40, 0x06, 0xB5, 0xB5, 0xC0, 0xA8, 0x01, 0x80, 0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x50, 0xC0, 0x81, 0x80, 0x12, 0x34, 0xFF, 0xFE, 0xDC, 0xBA, 0x98, 0x50, 0x12, 0x81, 0x23, 0xA8, 0x31, 0x00, 0x00, 0x48, 0x54, 0x54, 0x50, 0x2F, 0x31, 0x2E, 0x30, 0x20, 0x32, 0x30, 0x30, 0x20, 0x4F, 0x4B, 0x0D, 0x0A, 0x43, 0x6F, 0x6E, 0x74, 0x65, 0x6E, 0x74, 0x2D, 0x54, 0x79, 0x70, 0x65, 0x3A, 0x20, 0x74, 0x65, 0x78, 0x74, 0x2F, 0x68, 0x74, 0x6D, 0x6C, 0x0D, 0x0A, 0x43, 0x6F, 0x6E, 0x74, 0x65, 0x6E, 0x74, 0x2D, 0x4C, 0x65, 0x6E, 0x67, 0x74, 0x68, 0x3A, 0x20, 0x31, 0x30, 0x0D, 0x0A, 0x0D, 0x0A, 0x80, 0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87, 0x88, 0x89]
		var value: byte = 0x00

		for (var i = 0; i < 128; i++) {
			assert this.composer.TryRead(i, value) == PacketDataResult.Success
			assert value == expected[i]
		}

		assert this.composer.TryRead(-1, value) == PacketDataResult.Invalid
		assert this.composer.TryRead(128, value) == PacketDataResult.Invalid
	}

	@Test
	fn EmitsCompleteBody100()
	{
		assert this.Prepare(100) == PacketDataResult.Success
		assert this.composer.GetAvailableLength() == 219
		var expected: byte[219] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0x08, 0x00, 0x45, 0x00, 0x00, 0xCD, 0x00, 0x01, 0x40, 0x00, 0x40, 0x06, 0xB5, 0x5A, 0xC0, 0xA8, 0x01, 0x80, 0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x50, 0xC0, 0x81, 0x80, 0x12, 0x34, 0xFF, 0xFE, 0xDC, 0xBA, 0x98, 0x50, 0x12, 0x81, 0x23, 0x2D, 0xB7, 0x00, 0x00, 0x48, 0x54, 0x54, 0x50, 0x2F, 0x31, 0x2E, 0x30, 0x20, 0x32, 0x30, 0x30, 0x20, 0x4F, 0x4B, 0x0D, 0x0A, 0x43, 0x6F, 0x6E, 0x74, 0x65, 0x6E, 0x74, 0x2D, 0x54, 0x79, 0x70, 0x65, 0x3A, 0x20, 0x74, 0x65, 0x78, 0x74, 0x2F, 0x68, 0x74, 0x6D, 0x6C, 0x0D, 0x0A, 0x43, 0x6F, 0x6E, 0x74, 0x65, 0x6E, 0x74, 0x2D, 0x4C, 0x65, 0x6E, 0x67, 0x74, 0x68, 0x3A, 0x20, 0x31, 0x30, 0x30, 0x0D, 0x0A, 0x0D, 0x0A, 0x80, 0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87, 0x88, 0x89, 0x8A, 0x8B, 0x8C, 0x8D, 0x8E, 0x8F, 0x90, 0x91, 0x92, 0x93, 0x94, 0x95, 0x96, 0x97, 0x98, 0x99, 0x9A, 0x9B, 0x9C, 0x9D, 0x9E, 0x9F, 0xA0, 0xA1, 0xA2, 0xA3, 0xA4, 0xA5, 0xA6, 0xA7, 0xA8, 0xA9, 0xAA, 0xAB, 0xAC, 0xAD, 0xAE, 0xAF, 0xB0, 0xB1, 0xB2, 0xB3, 0xB4, 0xB5, 0xB6, 0xB7, 0xB8, 0xB9, 0xBA, 0xBB, 0xBC, 0xBD, 0xBE, 0xBF, 0xC0, 0xC1, 0xC2, 0xC3, 0xC4, 0xC5, 0xC6, 0xC7, 0xC8, 0xC9, 0xCA, 0xCB, 0xCC, 0xCD, 0xCE, 0xCF, 0xD0, 0xD1, 0xD2, 0xD3, 0xD4, 0xD5, 0xD6, 0xD7, 0xD8, 0xD9, 0xDA, 0xDB, 0xDC, 0xDD, 0xDE, 0xDF, 0xE0, 0xE1, 0xE2, 0xE3]
		var value: byte = 0x00

		for (var i = 0; i < 219; i++) {
			assert this.composer.TryRead(i, value) == PacketDataResult.Success
			assert value == expected[i]
		}

		assert this.composer.TryRead(-1, value) == PacketDataResult.Invalid
		assert this.composer.TryRead(219, value) == PacketDataResult.Invalid
	}

	@Test
	fn InvalidReplacementClearsOldFrame()
	{
		assert this.Prepare(3) == PacketDataResult.Success
		assert this.Prepare(1400) == PacketDataResult.Invalid
		assert !this.composer.IsReady()
		assert this.composer.GetAvailableLength() == 0
		var value: byte = 0xFF
		assert this.composer.TryRead(0, value) == PacketDataResult.NotReady
		assert this.Prepare(10) == PacketDataResult.Success
	}
}

namespace Livt.Web.Tests.Http
using Livt.Net
using Livt.Web.Http

/** Configurable test body of literal '<' bytes; snapshots length on selection. */
component TestHttpContent : IHttpContent
{
	lengths: int[3]
	length: int
	ready: bool
	failAt: int
	new()
	{
		this.failAt = -1
	}

	public fn FailAt(index: int)
	{
		this.failAt = index
	}

	public fn Configure(route: int, length: int)
	{
		this.lengths[route - 1] = length
	}

	override fn TrySelect(route: int) PacketDataResult
	{
		if (this.ready) {
			return PacketDataResult.Busy
		}

		if (route < 1 || route > 3) {
			return PacketDataResult.Invalid
		}

		this.length = this.lengths[route - 1]
		this.ready = true
		return PacketDataResult.Success
	}

	override fn Release()
	{
		this.ready = false
		this.length = 0
	}

	override fn IsReady() bool
	{
		return this.ready
	}

	override fn GetAvailableLength() int
	{
		return this.length
	}

	override fn TryRead(index: int, value: out byte) PacketDataResult
	{
		value = 0x00

		if (!this.ready) {
			return PacketDataResult.NotReady
		}

		if (index < 0 || index >= this.length) {
			return PacketDataResult.Invalid
		}

		if (index == this.failAt) {
			return PacketDataResult.Invalid
		}

		value = 0x3C
		return PacketDataResult.Success
	}
}

namespace Livt.Web.Tests.Http

using Livt.Web.Http
using Livt.Net

@Test
component WebServerTest
{
	const INDEX_HTML: byte[] = "<!doctype html><html><body><h1>Livt FPGA Web</h1></body></html>\n".Encode()

	fixture: byte[128]
	arpData: ArrayPacketData<1514>
	arpTx: TestFrameTransmitter<ArrayPacketData<1514>>
	responseData: ArrayPacketData<1514>
	responseTx: TestFrameTransmitter<ArrayPacketData<1514>>
	receiver: TestFrameReceiver<128>

	content: TestHttpContent
	server: WebServer<TestHttpContent>
	generator: HttpResponseGenerator

	new()
	{
		this.receiver = new TestFrameReceiver<128>()
		this.arpData = new ArrayPacketData<1514>()
		this.responseData = new ArrayPacketData<1514>()
		this.arpTx = new TestFrameTransmitter<ArrayPacketData<1514>>(this.arpData)
		this.responseTx = new TestFrameTransmitter<ArrayPacketData<1514>>(this.responseData)
		this.generator = new HttpResponseGenerator()
		var localMac: byte[6]
		localMac[0] = 0x02
		localMac[1] = 0xAA
		localMac[2] = 0xBB
		localMac[3] = 0xCC
		localMac[4] = 0xDD
		localMac[5] = 0xEE
		var localIp: byte[4]
		localIp[0] = 0x0A
		localIp[1] = 0x00
		localIp[2] = 0x00
		localIp[3] = 0x01
		var localPort: byte[2]
		localPort[0] = 0x00
		localPort[1] = 0x50
		this.content = new TestHttpContent()
		this.server = new WebServer<TestHttpContent>(this.content, localMac, localIp, localPort)
	}

	fn LoadFixtureByte(index: int, value: byte)
	{
		this.fixture[index] = value
	}

	fn SubmitFixture()
	{
		for (var i = 0; i < 128; i++) {
			assert this.receiver.InjectByte(i, this.fixture[i]) == FrameLinkResult.Success
		}

		assert this.receiver.Publish(true, 128) == FrameLinkResult.Success
		assert this.receiver.TryAcquire() == FrameLinkResult.Success
	}

	fn CopyFrameToServer()
	{
		this.server.BeginFrame()

		for (var i = 0; i < 128; i++) {
			var value: byte = 0x00
			assert this.receiver.TryRead(i, value) == PacketDataResult.Success
			this.server.LoadRxByte(i, value)
		}

		assert this.receiver.TryRelease() == FrameLinkResult.Success
		this.server.HandleFrame()
	}

	fn CopyResponseToTxFrame()
	{
		var responseLength = this.server.GetResponseLength()
		assert this.responseData.TryClear() == PacketDataResult.Success

		for (var i = 0; i < responseLength; i++) {
			var responseByte = this.ReadResponse(i)
			assert this.responseData.TryWrite(i, responseByte as byte) == PacketDataResult.Success
		}

		assert this.responseData.TryPublish() == PacketDataResult.Success
		assert this.responseTx.TrySubmit() == FrameLinkResult.Accepted

		for (var i = 0; i <= responseLength; i++) {
			this.responseTx.Advance()
		}
	}

	fn CopyArpResponseToTxFrame()
	{
		var responseLength = this.server.GetResponseLength()
		assert this.arpData.TryClear() == PacketDataResult.Success

		for (var i = 0; i < responseLength; i++) {
			var responseByte = this.ReadResponse(i)
			assert this.arpData.TryWrite(i, responseByte as byte) == PacketDataResult.Success
		}

		assert this.arpData.TryPublish() == PacketDataResult.Success
		assert this.arpTx.TrySubmit() == FrameLinkResult.Accepted

		for (var i = 0; i <= responseLength; i++) {
			this.arpTx.Advance()
		}
	}

	fn LoadEtherType(etherType: byte[2])
	{
		this.LoadFixtureByte(12, etherType[0])
		this.LoadFixtureByte(13, etherType[1])
	}

	fn LoadEthernetSourceMac(sourceMac: byte[6])
	{
		this.LoadFixtureByte(6, sourceMac[0])
		this.LoadFixtureByte(7, sourceMac[1])
		this.LoadFixtureByte(8, sourceMac[2])
		this.LoadFixtureByte(9, sourceMac[3])
		this.LoadFixtureByte(10, sourceMac[4])
		this.LoadFixtureByte(11, sourceMac[5])
	}

	fn LoadArpEthernetIpv4RequestHeader(header: byte[8])
	{
		this.LoadFixtureByte(12, 0x08)
		this.LoadFixtureByte(13, 0x06)
		this.LoadFixtureByte(14, header[0])
		this.LoadFixtureByte(15, header[1])
		this.LoadFixtureByte(16, header[2])
		this.LoadFixtureByte(17, header[3])
		this.LoadFixtureByte(18, header[4])
		this.LoadFixtureByte(19, header[5])
		this.LoadFixtureByte(20, header[6])
		this.LoadFixtureByte(21, header[7])
	}

	fn LoadArpSenderMac(senderMac: byte[6])
	{
		this.LoadFixtureByte(22, senderMac[0])
		this.LoadFixtureByte(23, senderMac[1])
		this.LoadFixtureByte(24, senderMac[2])
		this.LoadFixtureByte(25, senderMac[3])
		this.LoadFixtureByte(26, senderMac[4])
		this.LoadFixtureByte(27, senderMac[5])
	}

	fn LoadArpSenderIp(senderIp: byte[4])
	{
		this.LoadFixtureByte(28, senderIp[0])
		this.LoadFixtureByte(29, senderIp[1])
		this.LoadFixtureByte(30, senderIp[2])
		this.LoadFixtureByte(31, senderIp[3])
	}

	fn LoadArpTargetIp(targetIp: byte[4])
	{
		this.LoadFixtureByte(38, targetIp[0])
		this.LoadFixtureByte(39, targetIp[1])
		this.LoadFixtureByte(40, targetIp[2])
		this.LoadFixtureByte(41, targetIp[3])
	}

	fn LoadIpv4FixedTcpHeader(ipHeader: byte[4])
	{
		this.LoadFixtureByte(16, 0x00)
		this.LoadFixtureByte(17, 0x28)
		this.LoadFixtureByte(14, ipHeader[0])
		this.LoadFixtureByte(20, ipHeader[1])
		this.LoadFixtureByte(21, ipHeader[2])
		this.LoadFixtureByte(23, ipHeader[3])
	}

	fn LoadIpv4SourceIp(sourceIp: byte[4])
	{
		this.LoadFixtureByte(26, sourceIp[0])
		this.LoadFixtureByte(27, sourceIp[1])
		this.LoadFixtureByte(28, sourceIp[2])
		this.LoadFixtureByte(29, sourceIp[3])
	}

	fn LoadIpv4DestinationIp(destinationIp: byte[4])
	{
		this.LoadFixtureByte(30, destinationIp[0])
		this.LoadFixtureByte(31, destinationIp[1])
		this.LoadFixtureByte(32, destinationIp[2])
		this.LoadFixtureByte(33, destinationIp[3])
	}

	fn LoadTcpSourcePort(sourcePort: byte[2])
	{
		this.LoadFixtureByte(34, sourcePort[0])
		this.LoadFixtureByte(35, sourcePort[1])
	}

	fn LoadTcpDestinationPort(destinationPort: byte[2])
	{
		this.LoadFixtureByte(36, destinationPort[0])
		this.LoadFixtureByte(37, destinationPort[1])
	}

	fn LoadTcpSeqNum(seqNum: byte[4])
	{
		this.LoadFixtureByte(38, seqNum[0])
		this.LoadFixtureByte(39, seqNum[1])
		this.LoadFixtureByte(40, seqNum[2])
		this.LoadFixtureByte(41, seqNum[3])
	}

	fn LoadTcpDataOffsetAndFlags(dataOffsetAndFlags: byte[2])
	{
		this.LoadFixtureByte(46, dataOffsetAndFlags[0])
		this.LoadFixtureByte(47, dataOffsetAndFlags[1])
	}

	fn LoadTcpPayload6(payload: byte[6])
	{
		this.LoadFixtureByte(17, 0x2E)
		this.LoadFixtureByte(54, payload[0])
		this.LoadFixtureByte(55, payload[1])
		this.LoadFixtureByte(56, payload[2])
		this.LoadFixtureByte(57, payload[3])
		this.LoadFixtureByte(58, payload[4])
		this.LoadFixtureByte(59, payload[5])
	}

	@Test
	fn IgnoresUnsupportedFrame()
	{
		for (var i = 0; i < 128; i++) {
			this.fixture[i] = 0x00
		}

		var unsupportedEtherType: byte[2]
		unsupportedEtherType[0] = 0x12
		unsupportedEtherType[1] = 0x34

		this.LoadEtherType(unsupportedEtherType)
		this.SubmitFixture()

		this.CopyFrameToServer()

		assert this.server.HasResponse() == false
		assert this.server.GetResponseKind() == 0
		assert this.server.GetResponseLength() == 0
		assert this.responseData.IsReady() == false
	}

	@Test
	fn RespondsToArpRequest()
	{
		for (var i = 0; i < 128; i++) {
			this.fixture[i] = 0x00
		}

		var arpEthernetIpv4Request: byte[8]
		arpEthernetIpv4Request[0] = 0x00
		arpEthernetIpv4Request[1] = 0x01
		arpEthernetIpv4Request[2] = 0x08
		arpEthernetIpv4Request[3] = 0x00
		arpEthernetIpv4Request[4] = 0x06
		arpEthernetIpv4Request[5] = 0x04
		arpEthernetIpv4Request[6] = 0x00
		arpEthernetIpv4Request[7] = 0x01

		var clientMac: byte[6]
		clientMac[0] = 0x02
		clientMac[1] = 0x10
		clientMac[2] = 0x20
		clientMac[3] = 0x30
		clientMac[4] = 0x40
		clientMac[5] = 0x50

		var clientIp: byte[4]
		clientIp[0] = 0x0A
		clientIp[1] = 0x00
		clientIp[2] = 0x00
		clientIp[3] = 0x02

		var localIp: byte[4]
		localIp[0] = 0x0A
		localIp[1] = 0x00
		localIp[2] = 0x00
		localIp[3] = 0x01

		this.LoadArpEthernetIpv4RequestHeader(arpEthernetIpv4Request)
		this.LoadArpSenderMac(clientMac)
		this.LoadArpSenderIp(clientIp)
		this.LoadArpTargetIp(localIp)
		this.SubmitFixture()

		this.CopyFrameToServer()

		assert this.server.HasResponse() == true
		assert this.server.GetResponseKind() == 1
		assert this.server.GetResponseLength() == 60
		assert this.ReadResponse(0) == 0x02
		assert this.ReadResponse(5) == 0x50
		assert this.ReadResponse(6) == 0x02
		assert this.ReadResponse(7) == 0xAA
		assert this.ReadResponse(12) == 0x08
		assert this.ReadResponse(13) == 0x06
		assert this.ReadResponse(21) == 0x02

		this.CopyArpResponseToTxFrame()

		assert this.arpData.IsReady() == true
		assert this.arpTx.GetCapturedLength() == 60
		assert this.ReadarpTx(0) == 0x02
		assert this.ReadarpTx(5) == 0x50
		assert this.ReadarpTx(6) == 0x02
		assert this.ReadarpTx(7) == 0xAA
		assert this.ReadarpTx(12) == 0x08
		assert this.ReadarpTx(13) == 0x06
		assert this.ReadarpTx(21) == 0x02
	}

	@Test
	fn RespondsToHttpGetRootRequest()
	{
		for (var i = 0; i < 128; i++) {
			this.fixture[i] = 0x00
		}

		this.content.Configure(1, 64)

		var httpGetRoot = "GET / ".Encode()
		var response = "HTTP/1.0 200 OK".Encode()
		var content = "<!doctype html><html><body><h1>Livt FPGA Web</h1></body></html>".Encode()

		var clientMac: byte[6]
		clientMac[0] = 0x02
		clientMac[1] = 0x10
		clientMac[2] = 0x20
		clientMac[3] = 0x30
		clientMac[4] = 0x40
		clientMac[5] = 0x50

		var etherTypeIpv4: byte[2]
		etherTypeIpv4[0] = 0x08
		etherTypeIpv4[1] = 0x00

		var fixedIpv4TcpHeader: byte[4]
		fixedIpv4TcpHeader[0] = 0x45
		fixedIpv4TcpHeader[1] = 0x40
		fixedIpv4TcpHeader[2] = 0x00
		fixedIpv4TcpHeader[3] = 0x06

		var clientIp: byte[4]
		clientIp[0] = 0x0A
		clientIp[1] = 0x00
		clientIp[2] = 0x00
		clientIp[3] = 0x02

		var localIp: byte[4]
		localIp[0] = 0x0A
		localIp[1] = 0x00
		localIp[2] = 0x00
		localIp[3] = 0x01

		var clientPort: byte[2]
		clientPort[0] = 0xC0
		clientPort[1] = 0x01

		var httpPort: byte[2]
		httpPort[0] = 0x00
		httpPort[1] = 0x50

		var clientSeq: byte[4]
		clientSeq[0] = 0xAA
		clientSeq[1] = 0xBB
		clientSeq[2] = 0xCC
		clientSeq[3] = 0xDD

		// Send SYN
		var tcpSyn: byte[2]
		tcpSyn[0] = 0x50
		tcpSyn[1] = 0x02

		this.LoadEthernetSourceMac(clientMac)
		this.LoadEtherType(etherTypeIpv4)
		this.LoadIpv4FixedTcpHeader(fixedIpv4TcpHeader)
		this.LoadIpv4SourceIp(clientIp)
		this.LoadIpv4DestinationIp(localIp)
		this.LoadTcpSourcePort(clientPort)
		this.LoadTcpDestinationPort(httpPort)
		this.LoadTcpSeqNum(clientSeq)
		this.LoadTcpDataOffsetAndFlags(tcpSyn)
		this.SubmitFixture()

		this.CopyFrameToServer()

		assert this.server.GetResponseKind() == 3

		// Send ACK
		var tcpAck: byte[2]
		tcpAck[0] = 0x50
		tcpAck[1] = 0x10

		this.LoadTcpDataOffsetAndFlags(tcpAck)
		this.SubmitFixture()

		this.CopyFrameToServer()

		// Send HTTP GET
		var tcpPshAck: byte[2]
		tcpPshAck[0] = 0x50
		tcpPshAck[1] = 0x18

		this.LoadTcpDataOffsetAndFlags(tcpPshAck)
		this.LoadTcpPayload6(httpGetRoot)
		this.SubmitFixture()

		this.CopyFrameToServer()

		var indexLength = 64
		var bodyOffset = this.generator.GetBodyFrameOffset(indexLength)
		var expectedResponseLength = this.generator.GetResponseFrameLength(indexLength)

		assert this.server.HasResponse() == true
		assert this.server.GetResponseKind() == 4
		assert this.server.GetResponseLength() == expectedResponseLength
		assert this.ReadResponse(0) == 0x02
		assert this.ReadResponse(6) == 0x02
		assert this.ReadResponse(12) == 0x08
		assert this.ReadResponse(14) == 0x45
		assert this.ReadResponse(24) == 0x26
		assert this.ReadResponse(25) == 0x4D
		assert this.ReadResponse(34) == 0x00
		assert this.ReadResponse(36) == 0xC0
		assert this.ReadResponse(47) == 0x19
		assert this.ReadResponse(54) == response[0]
		assert this.ReadResponse(bodyOffset) == content[0]

		this.CopyResponseToTxFrame()

		assert this.responseData.IsReady() == true
		assert this.responseTx.GetCapturedLength() == expectedResponseLength
		assert this.ReadresponseTx(0) == 0x02
		assert this.ReadresponseTx(6) == 0x02
		assert this.ReadresponseTx(12) == 0x08
		assert this.ReadresponseTx(14) == 0x45
		assert this.ReadresponseTx(24) == 0x26
		assert this.ReadresponseTx(25) == 0x4D
		assert this.ReadresponseTx(34) == 0x00
		assert this.ReadresponseTx(36) == 0xC0
		assert this.ReadresponseTx(47) == 0x19
		assert this.ReadresponseTx(54) == response[0]
		assert this.ReadresponseTx(bodyOffset) == content[0]
	}

	/** Reads independently captured bytes from the device-independent transmitter. */
	fn ReadresponseTx(index: int) byte
	{
		var value: byte = 0x00
		assert this.responseTx.TryReadCaptured(index, value) == PacketDataResult.Success
		return value
	}

	/** Reads independently captured bytes from the device-independent transmitter. */
	fn ReadarpTx(index: int) byte
	{
		var value: byte = 0x00
		assert this.arpTx.TryReadCaptured(index, value) == PacketDataResult.Success
		return value
	}

	/** A checked read keeps legacy response assertions concise without masking errors. */
	fn ReadResponse(index: int) byte
	{
		var value: byte = 0x00
		assert this.server.TryReadResponse(index, value) == PacketDataResult.Success
		return value
	}
}

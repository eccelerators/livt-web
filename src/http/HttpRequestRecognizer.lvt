namespace Livt.Web.Http

using Livt.Net

/**
 * RFC 1945 — Hypertext Transfer Protocol -- HTTP/1.0
 * https://www.rfc-editor.org/rfc/rfc1945
 *
 * Recognizes a minimal HTTP GET token in a bounded TCP payload.
 * The path bytes are stored as fields and configured at startup with SetPath().
 * Defaults to "/" so callers that omit configuration still match the root path.
 */
component HttpRequestRecognizer<S: IPacketData>
{
	payload: S
	path: byte[7]
	pathLength: int

	new(payload: S)
	{
		this.payload = payload
		this.pathLength = 1
		this.path[0] = 0x2F
	}

	/**
	 * Configures the path to match.
	 * Only the first 7 bytes of path are used; length must be 1-7.
	 */
	public fn SetPath(b0: byte, b1: byte, b2: byte, b3: byte, b4: byte, b5: byte, b6: byte, length: int)
	{
		this.pathLength = length
		this.path[0] = b0
		this.path[1] = b1
		this.path[2] = b2
		this.path[3] = b3
		this.path[4] = b4
		this.path[5] = b5
		this.path[6] = b6
	}

	/**
	 * Recognizes only a captured GET token and configured path. The caller
	 * separately applies TCP endpoint/flags policy; this is not a full HTTP validator.
	 */
	public fn IsGetRequest() bool
	{
		if (pathLength < 1 || pathLength > 7 || !payload.IsReady()) { return false }
		if (payload.GetAvailableLength() < pathLength + 5) { return false }

		var prefix = "GET ".Encode()
		var value: byte = 0x00

		for (var i = 0; i < 4; i++) {
			if (payload.TryRead(i, value) != PacketDataResult.Success || value != prefix[i]) { return false }
		}

		for (var i = 0; i < pathLength; i++) {
			if (payload.TryRead(4 + i, value) != PacketDataResult.Success || value != path[i]) { return false }
		}

		if (payload.TryRead(4 + pathLength, value) != PacketDataResult.Success) { return false }

		return value == 0x20
	}
}

namespace Livt.Web.Http
using Livt.Net

/**
 * Prepared HTTP/1.0 frame composed from the shared TCP/IPv4/Ethernet components.
 * Borrows an already published body. Preparation validates lengths and reads
 * the HTTP stream once for the TCP checksum; emission never accepts replacement
 * bytes or externally supplied checksums.
 */
component HttpResponseFrameComposer<P: IPacketData> : IPacketData
{
	payload: HttpResponsePayload<P>
	segment: TcpSegment<HttpResponsePayload<P>>
	packet: TcpIpv4Packet<HttpResponsePayload<P>>
	frame: TcpIpv4Frame<HttpResponsePayload<P>>

	new(body: P)
	{
		this.payload = new HttpResponsePayload<P>(body)
		this.segment = new TcpSegment<HttpResponsePayload<P>>(this.payload)
		this.packet = new TcpIpv4Packet<HttpResponsePayload<P>>(this.segment)
		this.frame = new TcpIpv4Frame<HttpResponsePayload<P>>(this.packet)
	}

	/** Finish response reads/TX borrows first; the caller then releases the body. */
	public fn Invalidate()
	{
		this.frame.Invalidate()
		this.packet.Invalidate()
		this.segment.Invalidate()
		this.payload.Invalidate()
	}

	/** Addresses/ports/sequence use network order. Failure leaves no readable frame. */
	public fn TryPrepare(sourceMac: byte[6], destinationMac: byte[6],
		sourceIp: byte[4], destinationIp: byte[4], sourcePort: byte[2], destinationPort: byte[2],
		sequence: byte[4], acknowledgment: byte[4], flags: byte, window: byte[2]) PacketDataResult
	{
		this.Invalidate()
		var result = this.payload.TryPrepare()

		if (result != PacketDataResult.Success) {
			return result
		}

		result = this.segment.TryPrepare(sourceIp, destinationIp, sourcePort,
			destinationPort, sequence, acknowledgment, flags, window)

		if (result != PacketDataResult.Success) {
			this.Invalidate()
			return result
		}

		var identification: byte[2] = [0x00, 0x01]
		result = this.packet.TryPrepare(sourceIp, destinationIp, identification)

		if (result == PacketDataResult.Success) {
			result = this.frame.TryPrepare(sourceMac, destinationMac)
		}

		if (result != PacketDataResult.Success) {
			this.Invalidate()
		}

		return result
	}

	override fn IsReady() bool
	{
		return this.frame.IsReady()
	}

	override fn GetAvailableLength() int
	{
		return this.frame.GetAvailableLength()
	}

	override fn TryRead(index: int, value: out byte) PacketDataResult
	{
		return this.frame.TryRead(index, value)
	}
}

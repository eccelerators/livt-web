namespace Livt.Web.Http

using Livt.Net

/**
 * Narrow adapter helper: unsigned sequence advancement in network byte order.
 */
class HttpTcpSequence
{
	/**
	 * count is a validated payload length (or one SYN), not arbitrary signed data.
	 */
	public static inline fn Advance[](sequence: uint, count: int) byte[4]
	{
		var result: byte[4]
		result[0] = (sequence >> 24) as byte
		result[1] = (sequence >> 16) as byte
		result[2] = (sequence >> 8) as byte
		result[3] = sequence as byte
		var carry = count

		for (var step: int = 0; step < 4; step++) {
			var i = 3 - step
			var sum = NetworkOrder.ByteValue(result[i]) + carry
			result[i] = (sum % 256) as byte
			carry = sum / 256
		}

		return result
	}
}

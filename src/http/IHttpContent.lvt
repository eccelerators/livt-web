namespace Livt.Web.Http
using Livt.Net

/**
 * Selectable application content. Success publishes a stable bounded body for
 * one route. Busy preserves the current publication; failure publishes nothing.
 * The endpoint releases it only after invalidating all response views. Owners
 * must not mutate backing content until Release; reset all owners together.
 */
interface IHttpContent : IPacketData
{
	fn TrySelect(route: int) PacketDataResult
	fn Release()
}

namespace Livt.Web.Http
using Livt.Net

/** HTTP header plus borrowed published body, suitable as a TCP payload. */
component HttpResponsePayload<P: IPacketData> : IPacketData
{
	body: P
	generator: HttpResponseGenerator
	bodyLength: int
	headerLength: int
	ready: bool

	/** Borrows the selected body; owns the HTTP header encoder. */
	new(body: P)
	{
		this.body = body
		this.generator = new HttpResponseGenerator()
	}

	/** Invalidate ancestors first; does not release the body. */
	public fn Invalidate()
	{
		this.ready = false
		this.bodyLength = 0
		this.headerLength = 0
	}

	/** Limits this HTTP/1.0 response to the standard 1500-byte IPv4 envelope. */
	public fn TryPrepare() PacketDataResult
	{
		this.Invalidate()

		if (!this.body.IsReady()) {
			return PacketDataResult.NotReady
		}

		var size = this.body.GetAvailableLength()

		if (size < 0 || size > 1460) {
			return PacketDataResult.Invalid
		}

		var headerSize = this.generator.GetHeaderLength(size)

		if (headerSize + size > 1460) {
			return PacketDataResult.Invalid
		}

		this.bodyLength = size
		this.headerLength = headerSize
		this.ready = true
		return PacketDataResult.Success
	}

	override fn IsReady() bool
	{
		return this.ready
	}

	override fn GetAvailableLength() int
	{
		if (!this.ready) {
			return 0
		}

		return this.headerLength + this.bodyLength
	}

	/** Header and body are one byte stream, so TCP correctly pairs odd header lengths. */
	override fn TryRead(index: int, value: out byte) PacketDataResult
	{
		value = 0x00

		if (!this.ready) {
			return PacketDataResult.NotReady
		}

		if (index < 0 || index >= this.headerLength + this.bodyLength) {
			return PacketDataResult.Invalid
		}

		if (index < this.headerLength) {
			value = this.generator.GetHeaderByte(index, this.bodyLength) as byte
			return PacketDataResult.Success
		}

		return this.body.TryRead(index - this.headerLength, value)
	}
}

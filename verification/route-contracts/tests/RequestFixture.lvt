namespace Livt.Web.Prototype
using Livt.Net

/** Injected parsed view, deliberately not an HTTP parser. */
component RequestFixture<S: IPacketData> : IHttpRequest
{
	source: S
	length: int
	method: HttpMethod
	ready: bool
	fail: bool

	new(source: S)
	{
		this.source = source
	}

	public fn Publish(method: HttpMethod, length: int)
	{
		this.method = method
		this.length = length
		ready = true
		fail = false
	}

	public fn FailReads()
	{
		fail = true
	}

	public fn Invalidate()
	{
		ready = false
	}

	override fn IsReady() bool
	{
		return ready && source.IsReady()
	}

	override fn GetMethod() HttpMethod
	{
		return method
	}

	override fn GetPathLength() int
	{
		return length
	}

	override fn TryReadPath(index: int, value: out byte) PacketDataResult
	{
		value = 0x00

		if (!this.IsReady()) {
			return PacketDataResult.NotReady
		}

		if (fail || index < 0 || index >= length) {
			return PacketDataResult.Invalid
		}

		return source.TryRead(index, value)
	}
}
